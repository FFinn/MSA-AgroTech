@startuml C2_Primary_Microservices
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

title C2 — Вариант A: распределённые микросервисы на сервере фермы
LAYOUT_TOP_DOWN()

Person(operator, "Оператор фермы", "Реагирует на инциденты и управляет оборудованием")
Person(user, "Администратор / аналитик", "Управляет фермами и просматривает аналитику")

System_Boundary(farm, "Агент фермы — одна инсталляция на ферму") {
    Container(edge_ui, "Локальный API и интерфейс", "Web application", "Работа в LAN без интернета; проверка кэшированных ролей и аудит")
    Container(video, "Сервис видеоаналитики", "Python, GPU runtime", "Принимает видеопотоки, выполняет инференс и трекинг")
    Container(incidents, "Сервис инцидентов", "Прикладной сервис", "Применяет правила и ведёт жизненный цикл инцидентов")
    Container(devices, "Сервис управления устройствами", "Прикладной сервис + адаптеры", "Унифицирует кормушки, поилки и датчики разных производителей")
    Container(resources, "Сервис ресурсов", "Прикладной сервис", "Контролирует воду, запасы кормов и прогноз расхода")
    Container(metrics, "Сервис локальных метрик", "Прикладной сервис", "Собирает базовые и пользовательские метрики")
    Container(sync, "Сервис синхронизации", "Прикладной сервис", "Хранит межконтурный Outbox/Inbox, применяет конфигурацию и кэш ролей")
    Container(notify, "Сервис локальных уведомлений", "Прикладной сервис + GSM/LAN adapters", "Доставляет тревоги без внешнего интернета")
    ContainerQueue(edge_mq, "Локальный RabbitMQ", "RabbitMQ + MQTT plugin", "Телеметрия, команды и доменные события")
    ContainerDb(edge_db, "Изолированные логические БД сервисов", "PostgreSQL + TimescaleDB", "Один физический кластер; отдельные схемы, владельцы и учётные записи; Outbox/Inbox")
    ContainerDb(video_store, "Локальное видеохранилище", "MinIO", "Фрагменты событий с ограниченным retention")
}

System_Boundary(center, "Центральная платформа мониторинга") {
    Container(api, "API Gateway", "REST/HTTPS", "API для существующих web/mobile клиентов, проверка токенов и rate limiting")
    Container(registry, "Сервис реестра и конфигурации", "Прикладной сервис", "Фермы, агенты, устройства, версии правил и моделей")
    Container(ingestion, "Сервис приёма событий", "Прикладной сервис", "Идемпотентно принимает события, статусы и метаданные фрагментов")
    Container(central_metrics, "Сервис метрик и аналитики", "Прикладной сервис", "Потребляет события и строит базовые и пользовательские агрегаты")
    Container(commands, "Сервис команд", "Прикладной сервис", "Формирует команды фермам и отслеживает статусы")
    ContainerQueue(central_mq, "Центральный RabbitMQ", "RabbitMQ quorum queues", "Ingress-события и durable command queue каждого агента")
    ContainerDb(central_db, "Изолированные логические БД сервисов", "PostgreSQL + TimescaleDB", "Отдельные схемы и владельцы для Registry, Ingestion, Metrics и Commands")
    ContainerDb(central_store, "Объектное хранилище", "MinIO", "Выбранные видеофрагменты и артефакты моделей")
}

System_Ext(cameras, "Камеры", "RTSP/ONVIF, включая ночной режим")
System_Ext(iot, "Кормушки, поилки и датчики", "MQTT, Modbus, OPC UA и протоколы производителей")
System_Ext(local_channel, "Локальные каналы оповещения", "Сирена, табло, GSM/SMS")
System_Ext(idp, "Сервис идентификации", "OIDC/OAuth 2.1, MFA, RBAC")
System_Ext(existing_ui, "Существующие web/mobile клиенты", "Веб-портал и мобильное приложение «АгроТех Х»")
System_Ext(kafka, "Корпоративная Kafka", "Существующая событийная шина")
System_Ext(dwh, "DWH / Data Lake / BI", "ClickHouse, MinIO, Power BI")

Rel(operator, edge_ui, "Работает локально", "HTTPS/LAN")
Rel(user, existing_ui, "Работает", "HTTPS")
Rel(existing_ui, api, "Вызывает", "REST/HTTPS")
Rel(api, idp, "Проверяет токены", "OIDC/OAuth 2.1")
Rel(api, registry, "Управляет фермами и конфигурацией", "REST")
Rel(api, central_metrics, "Запрашивает метрики", "REST")
Rel(api, commands, "Создаёт команды", "REST + Idempotency-Key")

Rel(cameras, video, "Передают видеопотоки", "RTSP/ONVIF")
Rel(video, edge_mq, "Публикует результаты инференса", "AMQP")
Rel(iot, edge_mq, "Публикует MQTT-телеметрию; получает MQTT-команды", "MQTT")
Rel(iot, devices, "Передаёт данные legacy-адаптерам", "Modbus/OPC UA/протокол производителя")
Rel(devices, edge_mq, "Публикует нормализованные состояния и команды", "AMQP/MQTT")
Rel(edge_mq, incidents, "Доставляет результаты распознавания и состояния", "AMQP")
Rel(edge_mq, resources, "Доставляет расход и параметры воды", "AMQP")
Rel(edge_mq, metrics, "Доставляет события для метрик", "AMQP")
Rel(incidents, notify, "Запрашивает локальное оповещение", "AMQP")
Rel(notify, local_channel, "Оповещает", "LAN/GSM")
Rel(incidents, edge_db, "Хранит свою схему, Inbox и Outbox", "SQL")
Rel(devices, edge_db, "Хранит свою схему и Outbox", "SQL")
Rel(resources, edge_db, "Хранит свою схему и временные ряды", "SQL")
Rel(metrics, edge_db, "Хранит свою схему и агрегаты", "SQL")
Rel(video, video_store, "Сохраняет фрагменты событий", "S3 API")
Rel(edge_ui, incidents, "Читает и подтверждает инциденты", "REST/LAN")
Rel(edge_ui, devices, "Отправляет локальные команды", "REST/LAN")
Rel(sync, edge_db, "Хранит собственные Inbox/Outbox, конфигурацию и кэш ролей", "SQL")
Rel(sync, central_mq, "Публикует события и статусы, store-and-forward", "AMQP 0-9-1 over mTLS")
Rel(central_mq, sync, "Доставляет команды и конфигурацию", "AMQP 0-9-1 over mTLS")

Rel(registry, central_mq, "Публикует версии конфигурации", "AMQP")
Rel(commands, central_mq, "Публикует команды конкретной ферме", "AMQP")
Rel(central_mq, ingestion, "Доставляет события и статусы", "AMQP")
Rel(ingestion, central_db, "Хранит свой Inbox, Outbox и принятые данные", "SQL")
Rel(registry, central_db, "Хранит свой реестр и версии", "SQL")
Rel(central_metrics, central_db, "Хранит свои временные ряды и агрегаты", "SQL")
Rel(commands, central_db, "Хранит свои команды и статусы", "SQL")
Rel(ingestion, central_store, "Сохраняет выбранные фрагменты", "S3 API")
Rel(ingestion, kafka, "Публикует доменные события через Outbox", "Kafka Protocol")
Rel(kafka, central_metrics, "Доставляет принятые события для агрегации", "Kafka Protocol")
Rel(kafka, dwh, "Передаёт данные", "Kafka Connect/ETL")

SHOW_LEGEND()
@enduml
